default:
    @just --list

sync:
    uv sync --no-active

app port="8502":
    uv run --no-active streamlit run app.py --server.port {{port}} --server.headless true

test:
    uv run --no-active pytest -q

# Ilustrações do tutorial em illustrations/
generate-streamlit-illustrations:
    uv run --no-active --with matplotlib python scripts/generate_streamlit_illustrations.py
