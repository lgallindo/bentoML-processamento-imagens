default:
    @just --list

sync:
    uv sync --no-active

# Corpus padrão: samples/beaches/ na raiz (já no git). Picsum opcional abaixo.
download-samples:
    @echo "Corpus temático: $(git rev-parse --show-toplevel)/samples/beaches/"
    @echo "Confirme com: just -f $(git rev-parse --show-toplevel)/justfile verify-themed-samples"
    @echo "Picsum legado (opcional): uv run --no-active python scripts/download_samples.py 50"

# Legado — Lorem Picsum train_* (tema aleatório). Prefira download-samples acima.
download-samples-picsum count="50":
    uv run --no-active python scripts/download_samples.py {{count}}

extract-features:
    uv run --no-active python scripts/extract_image_features.py

build-corpus-stats:
    uv run --no-active python scripts/build_corpus_stats.py

build-request-stats:
    uv run --no-active python scripts/build_request_stats.py

save-grayscale-model:
    uv run --no-active python scripts/save_grayscale_model.py

serve port="3333":
    uv run --no-active bentoml serve service:ImageProcessor --reload --port {{port}}

swagger port="3333":
    @url="http://localhost:{{port}}/"; \
    if command -v xdg-open >/dev/null 2>&1; then \
        xdg-open "$url" >/dev/null 2>&1 || printf 'Abra a Swagger UI em: %s\n' "$url"; \
    else \
        printf 'Abra a Swagger UI em: %s\n' "$url"; \
    fi

# Relatorios do corpus de treino
curl-monitor-histogram-corpus-json port="3333" channel="L" bins="256":
    curl --fail --show-error --request POST \
        --form "channel={{channel}}" \
        --form "bins={{bins}}" \
        "http://localhost:{{port}}/monitor-histogram-corpus-json"

curl-monitor-histogram-corpus-csv port="3333" channel="L" bins="256" output="monitor-histogram-corpus.csv":
    curl --fail --show-error --request POST \
        --form "channel={{channel}}" \
        --form "bins={{bins}}" \
        "http://localhost:{{port}}/monitor-histogram-corpus-csv" \
        --output "{{output}}"

curl-monitor-histogram-corpus-image port="3333" channel="L" bins="256" output="monitor-histogram-corpus.png":
    curl --fail --show-error --request POST \
        --form "channel={{channel}}" \
        --form "bins={{bins}}" \
        "http://localhost:{{port}}/monitor-histogram-corpus-image" \
        --output "{{output}}"

