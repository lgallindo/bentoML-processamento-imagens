# Passagem offline: baixa bentoml-exer-* para exerciser_samples/ (sem HTTP local).
download-exerciser-samples count="50":
    uv run --no-active python scripts/download_exerciser_samples.py --count={{count}}

# So submete exer_*.jpg a /inference-grayscale e imprime tempos (servidor: just serve).
exercise-grayscale port="3333" count="50":
    uv run --no-active python scripts/exercise_grayscale.py --port={{port}} --count={{count}}

curl-inference-grayscale image output="grayscale.png" port="3333":
    curl --fail --show-error --request POST \
        --form "image=@{{image}}" \
        "http://localhost:{{port}}/inference-grayscale" \
        --output "{{output}}"

curl-inference-blur image output="blur.png" radius="4.0" port="3333":
    curl --fail --show-error --request POST \
        --form "image=@{{image}}" \
        --form "radius={{radius}}" \
        "http://localhost:{{port}}/inference-blur" \
        --output "{{output}}"

curl-inference-resize image output="resized.png" width="256" height="256" port="3333":
    curl --fail --show-error --request POST \
        --form "image=@{{image}}" \
        --form "width={{width}}" \
        --form "height={{height}}" \
        "http://localhost:{{port}}/inference-resize" \
        --output "{{output}}"

curl-erro endpoint image port="3333" *campos:
    @extra=""; for campo in {{campos}}; do extra="$extra --form $campo"; done; \
    curl --silent --show-error --write-out '\nHTTP %{http_code}\n' \
        --request POST --form "image=@{{image}}" $extra \
        "http://localhost:{{port}}/{{endpoint}}"

build:
    uv run --no-active bentoml build

list:
    uv run --no-active bentoml list

test:
    uv run --no-active pytest -q
